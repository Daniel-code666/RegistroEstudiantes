# Generar .env con: powershell -NoProfile -ExecutionPolicy Bypass -File scripts/init-docker.ps1
# Iniciar API y SQL Server: docker compose up -d --build --wait
# SQL Server requiere una clave fuerte. No cambie la clave tras crear el volumen
# sin actualizar tambien el login de SQL Server.
SQL_SERVER_PASSWORD=
JWT_SIGNING_KEY=
API_PORT=5088
FRONTEND_ORIGIN=http://localhost:4200
FRONTEND_SECONDARY_ORIGIN=http://localhost:5173
FRONTEND_PORT=5089
# Ruta del proyecto Angular. Ajustar al desplegar en otro equipo.
FRONTEND_PATH=C:/Users/Administrador/OneDrive/Documentos/Documentos/Certificaciones y docs/Laboral/Interrapidisimo/Front/RegistroEstudiante
SQL_SERVER_PORT=14334

# Solo se crea si no existe ningun administrador; no sobrescribe cuentas.
# Completar antes de habilitar. La clave debe tener entre 8 y 128 caracteres.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_LAST_NAME=Inicial
BOOTSTRAP_ADMIN_IDENTIFICATION_TYPE=Pasaporte
BOOTSTRAP_ADMIN_IDENTIFICATION_NUMBER=BOOTSTRAP-ADMIN
